{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node --files src/index.ts",
    "dev:test-local": "nodemon --watch src --ext ts --exec ts-node --files src/startLocalTest.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:db": "ts-node src/testDb.ts",
    "test:email": "ts-node src/testEmail.ts",
    "test:leaderboard-search-ranks": "ts-node src/scripts/testLeaderboardSearchRanks.ts",
    "reconcile:event-team-counts": "ts-node --files src/scripts/reconcileEventTeamCounts.ts",
    "test:events": "npm run build && node --test tests/eventPermissions.test.cjs",
    "test:event-teams": "npm run build && node --test tests/eventTeamRegistration.test.cjs",
    "test:event-team-reconciliation": "npm run build && node --test tests/eventTeamCountReconciliation.test.cjs",
    "test:local-safety": "npm run build && node --test tests/localTestSafety.test.cjs",
    "test:local-poster": "npm run build && node --test tests/localPosterStorage.test.cjs",
    "create:admin": "ts-node --files src/scripts/createAdmin.ts",
    "create:admin:test-local": "ts-node --files src/scripts/createLocalTestAdmin.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.0",
    "multer": "^2.4.0",
    "nodemailer": "10.1.2",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.2.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
