# Copy this file to backend/.env.test.local and replace every placeholder.
# Never reuse a production database user, password, or JWT secret here.
LOCAL_TEST_MODE=true
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
EMAIL_DELIVERY_MODE=disabled

MONGODB_URI=mongodb+srv://TEST_ONLY_USERNAME:URL_ENCODED_TEST_PASSWORD@YOUR_CLUSTER/hackerearth_hub_v3_test?retryWrites=true&w=majority
TEST_MONGODB_USERNAME=TEST_ONLY_USERNAME
JWT_SECRET=REPLACE_WITH_A_UNIQUE_LOCAL_SECRET_OF_AT_LEAST_32_CHARACTERS
